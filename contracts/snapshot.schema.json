{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "分析快照",
  "type": "object",
  "required": [
    "snapshot_id",
    "cohort",
    "drug_scope",
    "region_scope",
    "window",
    "created_at"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "cohort": {
      "type": "object",
      "required": ["cohort_id"],
      "properties": {
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "drug_scope": {
      "type": "object",
      "required": ["catalog_version", "drug_ids"],
      "properties": {
        "catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "drug_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "region_scope": {
      "type": "object",
      "required": ["region_codes"],
      "properties": {
        "region_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
