{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "冻结比较口径",
  "description": "一次支出比较的全部口径；任何字段变化都必须生成新口径（新 scope_id），不允许就地修改。",
  "type": "object",
  "required": [
    "population",
    "catalog_version",
    "drug_ids",
    "regions",
    "baseline_start",
    "baseline_end",
    "observation_start",
    "observation_end"
  ],
  "properties": {
    "population": {
      "type": "string",
      "minLength": 1,
      "description": "比较人群标识，指向外部治理的人群定义"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "description": "药品目录口径版本"
    },
    "drug_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "冻结时的药品清单"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "地区范围"
    },
    "baseline_start": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "baseline_end": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "observation_start": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "observation_end": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"}
  },
  "additionalProperties": false
}
